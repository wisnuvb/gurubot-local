# Salin ke .env.docker di root bundle:
#   copy config\.env.docker.example .env.docker
# Edit nilai GANTI_* sebelum docker compose up.

NODE_ENV=production

# --- MySQL di host Windows (via host.docker.internal) ---
DATABASE_URL=mysql://GANTI_USER:GANTI_SANDI@host.docker.internal:3306/GANTI_DB

# --- URL publik HTTPS (nginx :443) ---
NEXTAUTH_URL=https://gurubot.sekolah
NEXTAUTH_SECRET=GANTI_RANDOM_PANJANG
NEXT_PUBLIC_API_URL=https://gurubot.sekolah
JWT_SECRET=GANTI_RANDOM_PANJANG

# --- Layanan internal Docker network (jangan ubah hostname) ---
OCR_SERVICE_URL=http://ocr:2059
STT_API_URL=http://whisper:2063

# --- DNS LAN (Technitium DNS Server, container "dns") ---
# Password admin web console Technitium (http://127.0.0.1:5380, loopback-only).
# Dipakai juga oleh scripts/setup-dns.bat untuk login ke API dan set record gurubot.sekolah.
DNS_SERVER_ADMIN_PASSWORD=GANTI_RANDOM_PANJANG

# --- LLM: Qwen via Ollama di host ---
LLM_PROVIDER=qwen
LLM_MODEL=qwen3:1.7b
QWEN_API_URL=http://host.docker.internal:11434/v1/chat/completions

# --- Suara browser ---
NEXT_PUBLIC_STT_UPLOAD_WAV_PREFERRED=1

# --- Observability (nonaktif di deploy lokal) ---
SENTRY_DSN=
OTEL_SDK_DISABLED=true

# --- Whisper (service whisper) ---
WHISPER_MODEL_PRESET=medium
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=8
CALISTUNG_MODE=char

# --- Portal operator (http://127.0.0.1:2077 — terpisah dari app gurubot.sekolah) ---
# OPERATOR_AGENT_TOKEN dan OPERATOR_SETUP_PIN digenerate otomatis oleh ensure-operator-env.bat / docker-up.bat
OPERATOR_AGENT_TOKEN=GANTI_RANDOM_PANJANG
OPERATOR_SETUP_PIN=GANTI_PIN_6_DIGIT

# --- Fallback IP (jika pakai https://192.168.x.x) ---
# NEXTAUTH_URL=https://192.168.1.50
# NEXT_PUBLIC_API_URL=https://192.168.1.50
