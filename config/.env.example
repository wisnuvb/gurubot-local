# Salin ke artifacts/nextjs/.env oleh setup.bat
# Jangan commit .env berisi rahasia.

NODE_ENV=production

# --- MySQL (prasyarat: MySQL 8.0 Windows Service) ---
# Default deploy lapangan: user root + DB hasil import production
# Nama database harus cocok dengan DB yang sudah ada
DATABASE_URL="mysql://root@127.0.0.1:3306/gurubot_db"

# --- URL publik (nginx Docker HTTPS :443) ---
NEXTAUTH_URL="https://gurubot.sekolah"
NEXTAUTH_SECRET="wLrOFeub4Rc3DOeBpHRwBtTX4rtS803LEduNp/62hOY="
NEXT_PUBLIC_API_URL="https://gurubot.sekolah"
JWT_SECRET="WmDRLc9GhOgp8EXg3KKoRzT9TIQc8oXv4XaC+IeWnFc="

# Untuk deploy Docker, salin nilai ini ke .env.docker di root bundle.
# Legacy PM2: salin ke artifacts/nextjs/.env (bisa pakai http:// jika tanpa HTTPS).

# --- Layanan lokal (loopback only) ---
OCR_SERVICE_URL="http://127.0.0.1:2059"
STT_API_URL="http://127.0.0.1:2063"

# --- LLM: Qwen via Ollama (prasyarat manual, port 11434) ---
LLM_PROVIDER=qwen
LLM_MODEL=qwen3:1.7b
QWEN_API_URL="http://127.0.0.1:11434/v1/chat/completions"

# --- Upload soal (opsional) ---
# UPLOAD_DATA_DIR=%BUNDLE_ROOT%\data\uploads\questions

# --- Suara browser ---
NEXT_PUBLIC_STT_UPLOAD_WAV_PREFERRED=1

# --- Versi deploy (opsional) ---
NEXT_PUBLIC_APP_VERSION=20260716.1

# --- Fallback IP (jika router tidak mendukung DNS custom) ---
# NEXTAUTH_URL=http://192.168.1.50
# NEXT_PUBLIC_API_URL=http://192.168.1.50
