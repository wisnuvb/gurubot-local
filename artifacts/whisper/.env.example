# Salin ke artifacts/whisper/.env saat setup (setup.bat)
# Cache model HuggingFace — arahkan ke folder bundle (offline)
HF_HOME=__BUNDLE_ROOT__\artifacts\whisper\models\huggingface

# Preset: small (cepat) | medium (fine-tune ID, default produksi)
WHISPER_MODEL_PRESET=medium

# Inferensi CPU
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=8

# Opsional: override model HuggingFace penuh
# WHISPER_MODEL=cahya/faster-whisper-medium-id

# Default mode API: char | syllable | word
CALISTUNG_MODE=char

# ffmpeg harus ada di PATH atau tools\ffmpeg (setup.bat menambahkan ke PATH proses)
